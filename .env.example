SECRET_KEY_BASE=generate-with-bin-rails-secret
DATABASE_URL=postgresql://finance_tracker:change-me@db:5432/finance_tracker_production
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=true
FORCE_SSL=true
MAILER_SENDER=no-reply@example.com

# Licensed quote API. Responses must include licensed=true, license_id,
# event_id, symbol, bid, ask, last, daily_volume, and source_timestamp.
MARKET_DATA_API_URL=https://licensed-provider.example/
MARKET_DATA_API_TOKEN=
MARKET_DATA_SOURCE=licensed-provider

# Simulation only; this is not brokerage capital.
PAPER_OPENING_CASH=100000
