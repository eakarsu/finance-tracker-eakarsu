<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : "FinanceTracker" %></title>
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag "application", :media => "all" %>

    <link rel="icon" href="/favicon.ico">

    <%= javascript_include_tag "application" %>

    <!-- Le HTML5 shim, for IE6-8 support of HTML elements -->
    <!--[if lt IE 9]>
    <script src="//cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.2/html5shiv.min.js" type="text/javascript"></script>
    <![endif]-->
  <style>
.codex-rails-shell{display:grid;grid-template-columns:240px minmax(0,1fr);gap:20px;max-width:1500px;margin:0 auto;padding:16px}.codex-rails-main{min-width:0}
.codex-rails-sidebar{position:sticky;top:16px;align-self:start;height:calc(100vh - 32px);overflow:auto;padding:18px 12px;border-radius:12px;background:#0b1220;color:#f8fafc;border:1px solid #26364d}
.codex-rails-sidebar strong{display:block;font-size:16px;line-height:1.3;padding:8px 10px 16px;border-bottom:1px solid #334155}.codex-rails-sidebar nav{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:2px!important;padding-top:12px}
.codex-rails-sidebar nav a{display:block!important;color:#cbd5e1!important;text-decoration:none!important;padding:9px 11px!important;border-radius:8px;font-size:13px;font-weight:600;line-height:1.3}.codex-rails-sidebar nav a:hover,.codex-rails-sidebar nav a:focus-visible{background:#1e293b;color:#fff!important}
@media(max-width:800px){.codex-rails-shell{grid-template-columns:minmax(0,1fr)}.codex-rails-sidebar{position:relative;height:auto;max-height:280px}}
</style>
</head>
  <body>

  <%= render 'layouts/navigation' %>


    <div class="codex-rails-shell"><aside class="codex-rails-sidebar" aria-label="Application navigation"><strong>Finance Tracker</strong><nav aria-label="Sections"><% if ENV['BACKEND_PORT'].to_i > 0 %><a href="http://127.0.0.1:<%= ENV['BACKEND_PORT'].to_i %>/ai-workspace" target="_blank" rel="noopener">AI workspace</a><% end %>
<%= link_to "Home", root_path %>
<% if current_user %>
<%= link_to "My Portfolio", my_portfolio_path %>
<%= link_to "Paper Trading", paper_trading_path %>
<%= link_to "My Friends", my_friends_path %>
<%= link_to "My Profile", edit_registration_path(current_user) %>
<% else %>
<%= link_to "Sign In", new_user_session_path %>
<% end %>
</nav></aside><div class="codex-rails-main container">
      <div class="row">
        <div class="col-lg-9">
          <% flash.each do |type, message| %>
            <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %>"><%= message %></div>
          <% end %>
          <%= yield %>
        </div>
      </div><!--/row-->

      <footer>
        <p>&copy; Finance Tracker <%= Time.current.year %> · Paper trading only</p>
      </footer>

    </div> <!-- /container -->
    </div>

  <script src="/feature-pack/feature-pack.js" defer></script>
</body>
</html>
